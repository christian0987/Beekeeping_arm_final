# joint_limits.yaml - Configuration corrigée
default_velocity_scaling_factor: 0.1
default_acceleration_scaling_factor: 0.1

joint_limits:
  # Joint de rotation de la base
  robot_arm_base_turn:
    has_velocity_limits: true
    max_velocity: 0.5
    has_acceleration_limits: true
    max_acceleration: 0.5
    has_jerk_limits: false
    max_jerk: 0.0

  # Joint de rotation principal
  robot_arm_turn_joint:
    has_velocity_limits: true
    max_velocity: 0.5
    has_acceleration_limits: true
    max_acceleration: 0.5
    has_jerk_limits: false
    max_jerk: 0.0

  # Joint lever le bras
  robot_arm_up_joint:
    has_velocity_limits: true
    max_velocity: 0.5
    has_acceleration_limits: true
    max_acceleration: 0.5
    has_jerk_limits: false
    max_jerk: 0.0

  # Joint avant du bras
  robot_arm_front_joint:
    has_velocity_limits: true
    max_velocity: 0.5
    has_acceleration_limits: true
    max_acceleration: 0.5
    has_jerk_limits: false
    max_jerk: 0.0

  # Joint descendre le bras
  robot_arm_down_joint:
    has_velocity_limits: true
    max_velocity: 0.5
    has_acceleration_limits: true
    max_acceleration: 0.5
    has_jerk_limits: false
    max_jerk: 0.0

  # Joint de la main/poignet
  robot_hand_joint:
    has_velocity_limits: true
    max_velocity: 0.5
    has_acceleration_limits: true
    max_acceleration: 0.5
    has_jerk_limits: false
    max_jerk: 0.0

  # Doigts (optionnel)
  finger_1_joint:
    has_velocity_limits: true
    max_velocity: 0.3
    has_acceleration_limits: true
    max_acceleration: 0.3
    has_jerk_limits: false
    max_jerk: 0.0

  finger_2_joint:
    has_velocity_limits: true
    max_velocity: 0.3
    has_acceleration_limits: true
    max_acceleration: 0.3
    has_jerk_limits: false
    max_jerk: 0.0
