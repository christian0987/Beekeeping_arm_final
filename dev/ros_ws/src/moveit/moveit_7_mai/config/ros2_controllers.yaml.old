controller_manager:
  ros__parameters:
    update_rate: 100
    use_sim_time: true

joint_trajectory_controller:
  ros__parameters:
    joints:
      - robot_arm_base_turn
      - robot_arm_down_joint
      - robot_arm_front_joint
      - robot_arm_up_joint
      - robot_arm_turn_joint
      - finger_1_joint
      - finger_2_joint
    command_interfaces:
      - position
    state_interfaces:
      - position
    state_publish_rate: 50
    action_monitor_rate: 20